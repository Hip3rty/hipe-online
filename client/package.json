{
  "name": "@hipe/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cliente do Hipe Online (HTML5 Canvas + Capacitor para Android/iOS)",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "android:sync": "vite build && cap sync android",
    "android:apk": "vite build && cap sync android && cd android && gradlew assembleDebug",
    "ios:sync": "vite build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@hipe/shared": "*"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "vite": "^6.0.0"
  }
}
