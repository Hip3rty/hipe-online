# Copie para .env (ou configure no painel da hospedagem). Nunca publique o .env.

# Porta HTTP/WebSocket (Render/Koyeb definem automaticamente)
PORT=8080

# PostgreSQL (Supabase: Project Settings > Database > Connection string > "Session pooler", porta 5432)
# Exemplo Supabase: postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Exemplo Neon:     postgresql://usuario:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Vazio = usa arquivo local server/data/dev-db.json (somente desenvolvimento)
DATABASE_URL=
DATABASE_SSL=true

# Opcional: restringe origens do WebSocket (vírgula). Vazio = aceita todas (necessário para o app mobile).
ALLOWED_ORIGINS=

SAVE_INTERVAL_MS=60000
MAX_PLAYERS=150
REGISTER_LIMIT=5
LOG_LEVEL=info

# Cliente (build do APK): endereço público do servidor
# VITE_SERVER_URL=wss://hipe-online.onrender.com/ws
